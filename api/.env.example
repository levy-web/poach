# Copy to .env and fill in real values. .env is gitignored.
AT_USERNAME=sandbox
AT_API_KEY=

# Comma-separated. Add your machine's LAN IP here to test from a physical device.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call this API (native apps aren't
# subject to CORS, so this only matters for a web client). Empty = none allowed.
CORS_ALLOWED_ORIGINS=
